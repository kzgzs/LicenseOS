APP_NAME=LicenseOS
APP_ENV=production # 生产环境固定 production
# APP_KEY: 必须 base64: 开头，禁止行内注释和尾部空格，用 php artisan key:generate 生成
APP_KEY=
APP_DEBUG=false # 生产环境必须 false
APP_URL=https://your-domain.com # 改成你的域名，含 https://

LOG_CHANNEL=daily
LOG_LEVEL=warning # 生产建议 warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1 # 宝塔填 127.0.0.1，Docker 填 db
DB_PORT=3306
DB_DATABASE=licenseos
DB_USERNAME=licenseos
DB_PASSWORD= # 必填，填宝塔创建数据库时的密码

CACHE_DRIVER=redis # 生产用 redis，开发可用 file
SESSION_DRIVER=redis # 生产用 redis，开发可用 file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true # 生产 true，开发可 false

QUEUE_CONNECTION=redis # 生产用 redis，开发可用 database
QUEUE_RETRY_AFTER=90

REDIS_HOST=127.0.0.1 # 宝塔填 127.0.0.1，Docker 填 redis
REDIS_PASSWORD=null
REDIS_PORT=6379

STRIPE_KEY= # 从 dashboard.stripe.com/apikeys 获取
STRIPE_SECRET= # 从 dashboard.stripe.com/apikeys 获取
STRIPE_WEBHOOK_SECRET= # 从 dashboard.stripe.com/webhooks 获取
STRIPE_CONNECT_CLIENT_ID=

WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_KEY=
WECHAT_CERT_PATH=

ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

PLATFORM_FEE_RATE=10 # 平台抽成比例 %
PAYOUT_MIN_AMOUNT=10 # 最低提现金额
PAYOUT_DELAY_DAYS=7 # 提现延迟天数
PAYOUT_WITHDRAWAL_FEE=1 # 提现手续费

# ---------------------------------------------------------------------------
# Cloudflare R2 Object Storage (optional)
# Enable when local storage is running low. New uploads go to R2,
# existing local files remain accessible via automatic fallback.
# ---------------------------------------------------------------------------
PRODUCT_STORAGE_DISK=public # Set to 'r2' after configuring R2 credentials below
R2_ACCESS_KEY_ID= # Get from Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_SECRET_ACCESS_KEY= # Get from Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_BUCKET= # e.g. licenseos-products
R2_ENDPOINT= # e.g. https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_CUSTOM_DOMAIN= # Optional: e.g. https://cdn.your-domain.com (if you've set up custom domain)

MEILISEARCH_HOST= # 宝塔留空（自动用数据库搜索），Docker 填 http://meilisearch:7700
MEILISEARCH_KEY=

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@your-domain.com
MAIL_FROM_NAME=LicenseOS

WECHAT_OPEN_APP_ID= # 微信开放平台 AppID
WECHAT_OPEN_APP_SECRET= # 微信开放平台 AppSecret

# Feature Flags
REVIEWS_ENABLED=true # 产品评价全局总开关（优先级高于单产品开关）

BAIDU_TRANSLATE_APPID= # 百度翻译开放平台 AppID（用于产品描述自动翻译，留空则不翻译）
BAIDU_TRANSLATE_SECRET= # 百度翻译开放平台密钥
